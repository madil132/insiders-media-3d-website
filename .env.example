# Copy these into Vercel > Project > Settings > Environment Variables (not into any file you upload).

# EMAIL (choose A or B)
# A) Gmail: the sending account and a Google "app password" (16 characters)
GMAIL_USER=insidersmedia.agency@gmail.com
GMAIL_APP_PASSWORD=
# B) Resend instead (needs your domain verified at resend.com)
# RESEND_API_KEY=
# MAIL_FROM=Insiders Media <bookings@insidersmedia.xyz>

# Where new booking notifications go (defaults to GMAIL_USER)
OWNER_EMAIL=insidersmedia.agency@gmail.com

# Long random text. Protects the Mark as paid / Cancel buttons and the bookings list.
ADMIN_KEY=

# Optional
PAY_URL=            # Stripe Payment Link or PayPal.me link sent to consultation clients
MEETING_LINK=       # Google Meet or Zoom link included in confirmations
SITE_URL=https://insidersmedia.xyz

# DATABASE: added automatically when you connect Upstash Redis from the Vercel Storage tab
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
